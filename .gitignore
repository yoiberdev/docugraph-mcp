# Generated by Cargo
/target/
**/*.rs.bk
# Cargo.lock is committed: docugraph ships a binary, so builds must be
# reproducible. It was ignored here by the default library template, which also
# left CI's cache key hashFiles('**/Cargo.lock') resolving to the empty string.

# Environment & Secrets (Never commit secrets!)
.env
.env.*
!.env.example
*.key
*.pem

# Local databases, indexes & caches
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
/data/
/indexes/
/storage_cache/
/.docugraph_cache/
/evaluation/output/

# PDF files with potential copyright (User provided only)
/corpus/*.pdf
/docs/private/
*.pdf

# Operating System & IDEs
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*~
