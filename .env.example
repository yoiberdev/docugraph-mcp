# DocuGraph Configuration Example
# Copy this file to .env for local overrides (never commit actual secrets)

# Log level and filtering, read through tracing's EnvFilter.
# Logs always go to stderr; stdout carries JSON-RPC only.
# Examples: info | warn | debug | docugraph=debug,lopdf=warn
RUST_LOG=info

# Where indexed documents are cached, as <sha256>.json files.
#
# This is the only storage path the code reads, and it matters more than it
# looks: `docugraph index` and `docugraph serve` are separate processes, and this
# directory is the handoff between them. It defaults to `.docugraph_cache` in the
# *current working directory*, so an MCP client launched without a fixed `cwd`
# will resolve a different directory than the one you indexed into and report an
# empty corpus. Set it explicitly in your MCP client config.
DOCUGRAPH_CACHE_DIR=C:/Users/YOUR_USER/.docugraph_cache
