# DocuGraph Configuration Example
# Copy this file to .env for local overrides (never commit actual secrets)

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Storage paths
DOCUGRAPH_DATA_DIR=./data
DOCUGRAPH_INDEX_DIR=./indexes

# Optional: Remote Embedding Provider (defaults to local fastembed-rs model)
# DOCUGRAPH_EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=your-api-key-here
